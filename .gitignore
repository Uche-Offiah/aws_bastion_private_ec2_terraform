
# Terraform working directory
.terraform/

# Terraform state and sensitive state backups
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
!example.tfvars

# Terraform crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Saved Terraform plans
*.tfplan
tfplan

# Local environment secrets
.env
.env.*

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
